INPUTS_DIRECTORY=inputs
OUTPUTS_DIRECTORY=outputs

FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe

SILENCE_NOISE_THRESHOLD=-45dB
SILENCE_MINIMUM_DURATION_SECONDS=2
MINIMUM_CHUNK_DURATION_SECONDS=4
MAXIMUM_CHUNK_DURATION_SECONDS=60
CHUNK_PADDING_SECONDS=0.35
SHORT_SPEECH_MERGE_GAP_SECONDS=3

EXPORT_MP3_BITRATE=64k

ENABLE_CHUNK_MERGING=false
MERGED_CHUNK_MAXIMUM_DURATION_MINUTES=
MERGED_CHUNK_INSERT_SILENCE_SECONDS=0
MERGED_CHUNK_REENCODE_AUDIO=true

ENABLE_TRANSCRIPTION=true
TRANSCRIPTION_STRATEGY=blank-asr

WHISPER_COMMAND=mlx_whisper
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=auto



ASR_PROVIDER=openai-compatible
ASR_BASE_URL=
ASR_API_KEY=
ASR_TRANSCRIPTIONS_PATH=/audio/transcriptions
ASR_MODEL=Qwen3-ASR-1.7B-bf16
ASR_RESPONSE_FORMAT=verbose_json
ASR_ENABLE_STREAMING=false
ASR_PROMPT=This is Hong Kong maritime VHF radio audio. Prefer maritime domain spellings and terms when acoustically plausible. Important terms include: 海事, MARDEP, Marine Department, 警告, 碰撞危險, 碰撞危险, 碼頭, 码头, 一号位, 一號位. If speech sounds like 海市, 我哋, or 我哋是 in a maritime warning or hailing context, transcribe it as 海事. If speech sounds like Mardeep, maaf, ma de, or 马德 in maritime radio context, transcribe it as MARDEP. Preserve vessel names, callsigns, radio numerals, English words, Cantonese, and Mandarin as accurately as possible.
ASR_HOTWORDS=海事,MARDEP,Marine Department,警告,碰撞危險,碰撞危险,碼頭,码头,一号位,一號位
ASR_VOCABULARY=

LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
LLM_MODEL=Qwen3.5-35B-A3B-4bit
LLM_MAX_TOKENS=2048
LLM_ENABLE_STREAMING=true
ENABLE_LLM_LAYER=true
